@model IEnumerable<Hackathon_segunda_chamada.Models.RequerimentoSegundaChamada>

@{
    ViewData["Title"] = "Painel de Coordenação";
    Layout = "_Layout";
    var statusAtual = Context.Request.Query["status"].ToString();
}

@await Html.PartialAsync("_NavbarCoordenador")

<div class="container-fluid py-4">

    @* Mensagens de Feedback *@
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Sucesso!</strong> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erro!</strong> @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @* Cabeçalho *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Painel de Requerimentos de Segunda Chamada</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-novo-requerimento">
            ＋ Novo Requerimento
        </button>
    </div>

    @* Filtro por Status *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Painel", "Coordenador")" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="filtro-status" class="form-label fw-semibold small">Filtrar por Status</label>
                    <select id="filtro-status" name="status" class="form-select form-select-sm">
                        <option value="" selected="@(statusAtual == "" ? "selected" : null)">Todos</option>
                        <option value="Pendente" selected="@(statusAtual == "Pendente" ? "selected" : null)">⏳ Pendente</option>
                        <option value="Aprovado" selected="@(statusAtual == "Aprovado" ? "selected" : null)">✓ Aprovado</option>
                        <option value="Negado" selected="@(statusAtual == "Negado" ? "selected" : null)">✕ Negado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Filtrar</button>
                </div>
                @if (!string.IsNullOrEmpty(statusAtual))
                {
                    <div class="col-md-2">
                        <a href="@Url.Action("Painel", "Coordenador")" class="btn btn-sm btn-outline-secondary w-100">Limpar</a>
                    </div>
                }
            </form>
        </div>
    </div>

    @* Tabela de Requerimentos *@
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Matrícula</th>
                            <th scope="col">Matéria</th>
                            <th scope="col">Atestado</th>
                            <th scope="col">Status</th>
                            <th scope="col">Data</th>
                            <th scope="col">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var req in Model)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@req.MatriculaAluno</span></td>
                                    <td>@req.NomeMateria</td>
                                    <td><span class="badge bg-info text-white">@req.TipoAtestado</span></td>
                                    <td>
                                        @if (req.Status == "Pendente")
                                        {
                                            <span class="badge bg-warning text-dark">⏳ Pendente</span>
                                        }
                                        else if (req.Status == "Aprovado")
                                        {
                                            <span class="badge bg-success">✓ Aprovado</span>
                                        }
                                        else if (req.Status == "Negado")
                                        {
                                            <span class="badge bg-danger">✕ Negado</span>
                                        }
                                    </td>
                                    <td><small class="text-muted">@req.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small></td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-detalhes-@req.Id"
                                                title="Ver Detalhes">
                                            👁️ Ver
                                        </button>
                                        @if (req.Status == "Pendente")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-aprovar-@req.Id"
                                                    title="Aprovar">
                                                ✓ Aprovar
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-negar-@req.Id"
                                                    title="Negar">
                                                ✕ Negar
                                            </button>
                                        }
                                    </td>
                                </tr>

                                @* Modal de Detalhes *@
                                <div id="modal-detalhes-@req.Id" class="modal fade" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-semibold">Detalhes do Requerimento #@req.Id</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <span class="text-secondary small fw-semibold">Matrícula do Aluno</span>
                                                        <p class="mb-0 fw-semibold">@req.MatriculaAluno</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="text-secondary small fw-semibold">Matéria</span>
                                                        <p class="mb-0 fw-semibold">@req.NomeMateria</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="text-secondary small fw-semibold">Tipo de Atestado</span>
                                                        <p class="mb-0 fw-semibold">@req.TipoAtestado</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="text-secondary small fw-semibold">Status</span>
                                                        <p class="mb-0 fw-semibold">@req.Status</p>
                                                    </div>
                                                    <div class="col-md-12">
                                                        <span class="text-secondary small fw-semibold">Motivo da Ausência</span>
                                                        <p class="mb-0">@req.Motivo</p>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(req.MotivoRecusa))
                                                    {
                                                        <div class="col-md-12">
                                                            <div class="alert alert-danger mb-0">
                                                                <span class="fw-semibold d-block mb-1">Motivo da Recusa</span>
                                                                @req.MotivoRecusa
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="col-md-12">
                                                        <span class="text-secondary small fw-semibold">Atestado</span>
                                                        <div class="mt-1">
                                                            @if (!string.IsNullOrEmpty(req.URLAtestado))
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-primary"
                                                                        data-bs-dismiss="modal"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#modal-atestado-@req.Id">
                                                                    📎 Visualizar Documento
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12">
                                                        <span class="text-secondary small fw-semibold">Data de Criação</span>
                                                        <p class="mb-0">@req.DataCriacao.ToString("dd/MM/yyyy HH:mm:ss")</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Modal de Aprovação *@
                                <div id="modal-aprovar-@req.Id" class="modal fade" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-semibold">Aprovar Requerimento</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Tem certeza que deseja <strong>aprovar</strong> este requerimento?</p>
                                                <div class="alert alert-info">
                                                    <strong>Requerimento #@req.Id</strong><br>
                                                    Aluno: @req.MatriculaAluno<br>
                                                    Matéria: @req.NomeMateria
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form method="post" action="@Url.Action("Aprovar", "Coordenador")" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@req.Id">
                                                    <button type="submit" class="btn btn-success">✓ Aprovar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Modal de Negação *@
                                <div id="modal-negar-@req.Id" class="modal fade" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-semibold">Negar Requerimento</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <form method="post" action="@Url.Action("Negar", "Coordenador")">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <div class="alert alert-danger mb-3">
                                                        <strong>Requerimento #@req.Id</strong><br>
                                                        Aluno: @req.MatriculaAluno<br>
                                                        Matéria: @req.NomeMateria
                                                    </div>
                                                    <div>
                                                        <label for="motivo-@req.Id" class="form-label fw-semibold">
                                                            Motivo da Recusa <span class="text-danger">*</span>
                                                        </label>
                                                        <textarea id="motivo-@req.Id"
                                                                  name="motivo"
                                                                  class="form-control"
                                                                  rows="4"
                                                                  placeholder="Explique o motivo da recusa..."
                                                                  required></textarea>
                                                        <small class="text-muted">Campo obrigatório</small>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <input type="hidden" name="id" value="@req.Id">
                                                    <button type="submit" class="btn btn-danger">✕ Negar</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                @* Modal de Visualização do Atestado *@
                                @if (!string.IsNullOrEmpty(req.URLAtestado))
                                {
                                    var extensao = System.IO.Path.GetExtension(req.URLAtestado).ToLowerInvariant();
                                    <div id="modal-atestado-@req.Id" class="modal fade" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-semibold">Atestado — Requerimento #@req.Id</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                                </div>
                                                <div class="modal-body p-0" style="min-height: 70vh;">
                                                    @if (extensao == ".pdf")
                                                    {
                                                        <iframe src="@req.URLAtestado"
                                                                style="width:100%; height:75vh; border:none;"
                                                                title="Atestado PDF"></iframe>
                                                    }
                                                    else if (extensao == ".jpg" || extensao == ".jpeg" || extensao == ".png")
                                                    {
                                                        <div class="d-flex justify-content-center align-items-center p-3" style="min-height:70vh;">
                                                            <img src="@req.URLAtestado"
                                                                 alt="Atestado"
                                                                 class="img-fluid rounded"
                                                                 style="max-height: 75vh; object-fit: contain;" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex flex-column justify-content-center align-items-center p-5 text-secondary" style="min-height:70vh;">
                                                            <span style="font-size:4rem;">📎</span>
                                                            <p class="mt-3">Não é possível visualizar este tipo de arquivo diretamente.</p>
                                                            <a href="@req.URLAtestado" download class="btn btn-outline-primary mt-2">⬇ Baixar Arquivo</a>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer">
                                                    <a href="@req.URLAtestado" download class="btn btn-outline-secondary btn-sm">⬇ Baixar</a>
                                                    <button type="button"
                                                            class="btn btn-primary btn-sm"
                                                            data-bs-dismiss="modal"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modal-detalhes-@req.Id">
                                                        ← Voltar aos Detalhes
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-4">
                                    Nenhum requerimento encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@* Modal de Novo Requerimento — upload de arquivo *@
<div id="modal-novo-requerimento" class="modal fade" tabindex="-1" aria-labelledby="modal-novo-requerimento-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="modal-novo-requerimento-label">Novo Requerimento de Segunda Chamada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <form id="form-novo-requerimento" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="mb-3">
                        <label for="matricula-aluno" class="form-label fw-semibold">Matrícula do Aluno <span class="text-danger">*</span></label>
                        <input type="number"
                               id="matricula-aluno"
                               name="matriculaAluno"
                               class="form-control"
                               placeholder="Digite a matrícula do aluno"
                               required>
                        <small class="text-muted">A matrícula será usada para carregar as matérias do aluno</small>
                    </div>

                    <div class="mb-3">
                        <label for="select-materia" class="form-label fw-semibold">Matéria <span class="text-danger">*</span></label>
                        <select id="select-materia"
                                name="nomeMateria"
                                class="form-select"
                                required
                                disabled>
                            <option value="" disabled selected>Digite a matrícula primeiro...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="motivo-novo" class="form-label fw-semibold">Motivo da Ausência <span class="text-danger">*</span></label>
                        <textarea id="motivo-novo"
                                  name="motivo"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Descreva o motivo da ausência"
                                  required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Atestado <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="tipoAtestado"
                                       id="tipo-medico-coord"
                                       value="medico"
                                       required>
                                <label class="form-check-label" for="tipo-medico-coord">Médico</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="tipoAtestado"
                                       id="tipo-trabalho-coord"
                                       value="trabalho">
                                <label class="form-check-label" for="tipo-trabalho-coord">Trabalho</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="tipoAtestado"
                                       id="tipo-obito-coord"
                                       value="obito">
                                <label class="form-check-label" for="tipo-obito-coord">Óbito</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="arquivo-atestado" class="form-label fw-semibold">Arquivo do Atestado <span class="text-danger">*</span></label>
                        <input type="file"
                               id="arquivo-atestado"
                               name="arquivo"
                               class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png"
                               required>
                        <div class="form-text text-secondary">Formatos aceitos: PDF, JPG, JPEG, PNG. Tamanho máximo: 10 MB.</div>
                    </div>

                    <div id="preview-novo" class="mb-3 d-none"></div>
                    <div id="alerta-novo" class="alert d-none" role="alert"></div>

                </div>

                <div class="modal-footer d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm text-primary d-none me-auto" id="spinner-novo" role="status" aria-hidden="true"></div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btn-cadastrar" class="btn btn-primary">Cadastrar Requerimento</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Carregar matérias ao digitar matrícula
        document.getElementById('matricula-aluno').addEventListener('change', async function () {
            const matricula = this.value;
            const selectMateria = document.getElementById('select-materia');

            if (!matricula) {
                selectMateria.disabled = true;
                selectMateria.innerHTML = '<option value="" disabled selected>Digite a matrícula primeiro...</option>';
                return;
            }

            try {
                const response = await fetch(`@Url.Action("BuscarMateriasPorMatricula", "RequerimentoSegundaChamada")?matricula=${matricula}`);
                const data = await response.json();

                selectMateria.innerHTML = '<option value="" disabled selected>Selecione uma matéria</option>';

                if (data.sucesso && data.dados.length > 0) {
                    data.dados.forEach(materia => {
                        const option = document.createElement('option');
                        option.value = materia;
                        option.textContent = materia;
                        selectMateria.appendChild(option);
                    });
                    selectMateria.disabled = false;
                } else {
                    selectMateria.innerHTML = '<option value="" disabled selected>Nenhuma matéria encontrada</option>';
                    selectMateria.disabled = true;
                }
            } catch (error) {
                console.error('Erro ao buscar matérias:', error);
                selectMateria.innerHTML = '<option value="" disabled selected>Erro ao carregar matérias</option>';
            }
        });

        // Preview do arquivo
        document.getElementById('arquivo-atestado').addEventListener('change', function () {
            const preview = document.getElementById('preview-novo');
            if (!this.files || this.files.length === 0) {
                preview.classList.add('d-none');
                return;
            }
            const arquivo = this.files[0];
            const ext = arquivo.name.split('.').pop().toLowerCase();
            preview.classList.remove('d-none');

            if (['jpg', 'jpeg', 'png'].includes(ext)) {
                const url = URL.createObjectURL(arquivo);
                preview.innerHTML = `<img src="${url}" class="img-thumbnail" style="max-height:150px;" alt="Preview">`;
            } else {
                preview.innerHTML = `<div class="d-flex align-items-center gap-2 p-2 border rounded bg-light">
                    <span style="font-size:2rem;">📄</span>
                    <span class="small fw-semibold">${arquivo.name}</span>
                </div>`;
            }
        });

        // Envio via fetch com multipart
        document.getElementById('btn-cadastrar').addEventListener('click', async function () {
            const form = document.getElementById('form-novo-requerimento');
            const spinner = document.getElementById('spinner-novo');
            const alerta = document.getElementById('alerta-novo');
            const btn = this;

            // Validação básica
            const matricula = document.getElementById('matricula-aluno').value;
            const materia = document.getElementById('select-materia').value;
            const motivo = document.getElementById('motivo-novo').value.trim();
            const tipo = document.querySelector('input[name="tipoAtestado"]:checked')?.value;
            const arquivo = document.getElementById('arquivo-atestado').files[0];

            if (!matricula || !materia || !motivo || !tipo || !arquivo) {
                alerta.className = 'alert alert-danger';
                alerta.textContent = 'Preencha todos os campos obrigatórios.';
                return;
            }

            spinner.classList.remove('d-none');
            btn.disabled = true;
            alerta.className = 'alert d-none';

            try {
                const formData = new FormData();
                formData.append('matriculaAluno', matricula);
                formData.append('nomeMateria', materia);
                formData.append('motivo', motivo);
                formData.append('tipoAtestado', tipo);
                formData.append('arquivo', arquivo);

                const csrfToken = form.querySelector('input[name="__RequestVerificationToken"]');
                if (csrfToken) formData.append('__RequestVerificationToken', csrfToken.value);

                const resposta = await fetch('@Url.Action("CriarParaAluno", "Coordenador")', {
                    method: 'POST',
                    body: formData
                });

                const dados = await resposta.json();

                alerta.className = `alert ${dados.sucesso ? 'alert-success' : 'alert-danger'}`;
                alerta.textContent = dados.mensagem;

                if (dados.sucesso) {
                    setTimeout(() => {
                        // Fecha modal e recarrega a página para mostrar o novo requerimento
                        const modalEl = document.getElementById('modal-novo-requerimento');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        modalEl.addEventListener('hidden.bs.modal', () => location.reload(), { once: true });
                    }, 1200);
                }
            } catch (err) {
                alerta.className = 'alert alert-danger';
                alerta.textContent = 'Erro ao enviar. Tente novamente.';
            } finally {
                spinner.classList.add('d-none');
                btn.disabled = false;
            }
        });
    </script>
}
